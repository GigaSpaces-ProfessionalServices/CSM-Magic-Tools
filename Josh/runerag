# Use sql/sql_orig to get "data" and "nl_result" - eRAG experimental app/Sql Nlp Query
# $1 - sql statement
# $2 - NL_RESULT_ORIG or NL_RESULT
function get_nl_result() {

  local run_sql="$(echo -n "${1}" | sed "s/'/'\\\''/g" | tr -d '\n\r')"
  local nl_result_type=$2                          # either NL_RESULT or NL_RESULT_ORIG
  #local run_sql="$(echo -n "${1}" | tr -d '\n\r')"
  echo "${run_sql}" > debug/${my_id}_${nl_result_type}_get_nl_result_run_sql-$_OUTPUT   #debug

  # Build the curl command in an array
  cat << EOF > debug/${my_id}_${nl_result_type}_get_nl_result_curl_cmd-$_OUTPUT
  curl -s -o "${_CURL_RESPONSE}" -w "%{http_code}" \\
  -X 'POST' '${eRAG_experimental_app}/v1/toucan-sql/sql-nlp-query' \\
  -H 'accept: application/json' \\
  -H 'correlation-id: ${_CORRELATION_UID}' \\
  -H 'user-id: ${_USERID}' \\
  -H '${_TOK}' \\
  -H 'Content-Type: application/json' \\
  -d '{
  "query": "${_QUESTION}",
  "sql": "${run_sql}",
  "model": "azure-openai-gpt4o-2024-08-06",
  "applicationId": ${_APPLICATIONID}
  }'
EOF

  _HTTP_CODE["${FUNCNAME[0]}"]=$(bash debug/${my_id}_${2}_get_nl_result_curl_cmd-$_OUTPUT)
  cat ${_CURL_RESPONSE} > debug/${my_id}_${2}_CURL_RESPONSE-$_OUTPUT   #debug
  cat ${_CURL_RESPONSE}                 # Return result to function caller

}

