#   _NL_RESULT="$(get_nl_result "${_SQL_SED}" NL_RESULT)"
#   echo "${_NL_RESULT}" > debug/${my_id}_NL_RESULT-$_OUTPUT   #debug

#   # _DATA
#   _DATA="$( echo ${_NL_RESULT} | jq -e '.tabular_data.data' | tr -d '\n' )"
#   _DATA_SORTED="$( echo ${_NL_RESULT} | jq -e '.tabular_data.data' | jq 'sort' | tee DATA_SORTED )"
#   echo "${_DATA}" > debug/${my_id}_DATA-$_OUTPUT   #debug
#   echo "${_DATA_SORTED}" > debug/${my_id}_DATA_SORTED-$_OUTPUT   #debug
#   echo -e "_SQL_SED $(declare -p _HTTP_CODE)" >> HTTP_CODE

    #============================================ COMPARISON
    r1_empty="$(echo -n "${_DATA_ORIG}" | tr -d '[] \n\r')"
    r2_empty="$(echo -n "${_DATA}" | tr -d '[] \n\r')"


    #================
    #================
    #= PRINT REPORT =
