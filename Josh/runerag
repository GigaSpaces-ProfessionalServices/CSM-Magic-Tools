#!/bin/bash

# Check requirements

python3 --version >/dev/null 2>&1 || { echo "\nInstall python3\n" ; exit 1 ; }
cd ; cd erag || { echo "\nCreate erag directory\n" ; exit 1 ; }
# e.g. token file contents: "Authorization: Token -WiA1-MmPjMG_bhXYO$8nDZE5UZ4@cq1bGrBCvTpmO"
[[ ! -s token ]] && { echo "\nPut token in file erag/token\n" ; exit 1 ; }
[[ ! -s accuracy.tsv ]] && { echo "\nImport file erag/accuracy.tsv\n" ; exit 1 ; }

# ENVIRONMENT

tok="$(cat token)"
_APPLICATIONID=""
_USERID=1
_TOPICID=""
_MSG_BODY=""
_MSG_BODY_ID=""
_SQL=""                           # New SQL statement
_SQL_SED=""                       # New SQL statement - escaping double quotes are escaped: \"
_SQL_ORIG=""                      # Original SQL statement
_SQL_ORIG_SED=""                  # Original SQL statement - double quotes are escaped: \"
_MSG_DETAILS=""
# Variables for 3 columns of eRAG Accuracy Dashboard
_SERIAL=""                        # Question ID
_QUESTION=""                      # Question asked - double quotes are escaped: \"
_RESULT=""                        # Current Query result
_RESULT_ORIG=""                   # Confirmed Query result

check_python_venv() {

#python3 -m venv myvenv
#source myvenv/bin/activate
#pip install beautifulsoup4

# Define the virtual environment path
VENV_PATH="myvenv"
# Step 1: Check if the virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    #echo "Virtual environment not found. Creating one..."
    python3 -m venv "$VENV_PATH" || { echo "Failed to create virtual environment"; exit 1; }
fi
# Step 2: Activate the virtual environment
source "$VENV_PATH/bin/activate" || { echo "Failed to activate virtual environment"; exit 1; }
# Step 3: Check if beautifulsoup4 is installed
if ! pip show beautifulsoup4 > /dev/null 2>&1; then
    #echo "BeautifulSoup4 is not installed. Installing it now..."
    pip install beautifulsoup4 || { echo "Failed to install BeautifulSoup4"; exit 1; }
fi
}

# FUNCTIONS

# Get applicationId - eRAG experimental app/Get All Applications
function get_applicationId() {
  export _APPLICATIONID=$( curl -sX 'GET' \
  'https://tenant-goldenset.erag-c1.gigaspaces.net/api/erag-backend/v1/applications' \
  -H 'accept: application/json' \
  -H "$tok" | jq '.[].applicationId' )
  #echo _APPLICATIONID=$_APPLICATIONID
}

# Get topic id - FastAPI/get all topics for this app for this user
function get_topicid() {
  export _TOPICID=$(curl -sX 'GET' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${tok}" | jq '.[].id' )
  #echo _TOPICID=$_TOPICID
}

# Get FastAPI/Submit a new question to the topic
function post_message() {
  _MSG_BODY=$(curl -sX 'POST' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics/${_TOPICID}/messages" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${tok}" \
  -H 'Content-Type: application/json' \
  -d '{ "message": "'"${_QUESTION}"'" }')
  export _MSG_BODY_ID=$(echo "${_MSG_BODY}" | jq '.[] | select(.role? == "assistant") | .id')
}

# Get FastAPI/Get message details
function get_message_details() {
  _MSG_DETAILS=$(curl -sX 'GET' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics/${_TOPICID}/messages/${_MSG_BODY_ID}" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${tok}")
  export _SQL=$(echo "${_MSG_DETAILS}" | jq -r '.sql')
  export _SQL_SED=$(echo "${_SQL}" | sed 's/"/\\"/g')
}

get_nl_result() {
local run_sql="${1}"
curl -sX 'POST' \
  'https://tenant-goldenset.erag-c1.gigaspaces.net/api/erag-backend/v1/toucan-sql/sql-nlp-query' \
  -H 'accept: application/json' \
  -H "${tok}" \
  -H 'Content-Type: application/json' \
  -d '{
  "query": "",
  "sql": "'"${run_sql}"'",
  "model": "azure-openai-gpt4o-2024-08-06",
  "applicationId": '"${_APPLICATIONID}"'
  }'
}

html_to_text() {
html="${1}"

# Convert HTML to a single line of text using BeautifulSoup
text=$(python3 <<EOF
import sys
from bs4 import BeautifulSoup

html_data = """$html"""
soup = BeautifulSoup(html_data, 'html.parser')

# Get all the text, separated by spaces instead of newlines
plain_text = soup.get_text(separator=' ')

# Strip leading/trailing spaces
plain_text = plain_text.strip()

print(plain_text)
EOF
)

echo -ne "$(echo "${text}" | tr '\n' ' ' | sed 's/  */ /g')"
}


###################################
# Compare original sql with new sql
# col1 = Serial
# col2 = Question
# col3 = Query
# Date, question ID, question, Confirmed query, Current query, comparison results (correct, not correct, inconclusive)
# put it in a CSV
do_compare_sqls2() {
  while IFS=$'\t' read -r col1 col2 col3 ; do
    _QUESTION=$(echo "${col2}" | sed 's/"/\\"/g')
    _SQL_ORIG="${col3}"
    _SQL_ORIG_SED="$(echo ${col3} | sed 's/"/\\"/g')"
    get_applicationId                         # set _APPLICATIONID
    get_topicid                               # set _TOPICID
    post_message                              # set _MSG_BODY and _MSG_BODY_ID

    #echo -e "\n $col1 \n"
    #echo -e "\n _MSG_BODY_ID=$_MSG_BODY_ID\n"
    #echo -e "\n _MSG_BODY=$_MSG_BODY\n"
    get_message_details                       # set _MSG_DETAILS, _SQL and _SQL_SED 
    #echo -e "\n_SQL_SED=${_SQL_SED}\n"
    #echo -e "\n_SQL_ORIG_SED=${_SQL_ORIG_SED}\n"

    _NL_RESULT_ORIG=$(get_nl_result "${_SQL_ORIG_SED}" | jq -r '.nl_result')      # Get nl_result from _SQL_ORIG_SED
    _NL_RESULT=$(get_nl_result "${_SQL_SED}" | jq -r '.nl_result')                # Get nl_result from _SQL_SED
    #echo -e "\n${_NL_RESULT_ORIG}"             # CONFIRMED query (response to SQL query)
    #echo -e "\n${_NL_RESULT}"                  # CURRENT query (response to SQL query)

    # save values to files for do_compare func
    #echo "${_NL_RESULT_ORIG}" > r1
    #echo "${_NL_RESULT}" > r2
    html_to_text "${_NL_RESULT_ORIG}" > r1
    html_to_text "${_NL_RESULT}" > r2

    # Print report
    echo -ne "$(date '+%Y/%m/%d')\t"            # DATE
    echo -ne "${col1}\t"                        # QUESTION ID
    echo -ne "${col2}\t"                        # QUESTION
    #echo -ne "$(echo ${_NL_RESULT_ORIG} | tr '\n' ' ')\t"             # CONFIRMED query (response to SQL)
    #echo -ne "$(echo ${_NL_RESULT} | tr '\n' ' ')\t"                  # CURRENT query (response to SQL)

    echo -ne "${_SQL_ORIG}\t"
    echo -ne "$(html_to_text "${_NL_RESULT_ORIG}")\t"           # CONFIRMED query (response to SQL)
    echo -ne "${_SQL}\t"
    echo -ne "$(html_to_text "${_NL_RESULT}")\t"                # CURRENT query (response to SQL)

    [[ "$(md5sum r1)" == "$(md5sum r2)" ]] && echo -ne "correct\t" || echo -ne "incorrect\t"   # COMPARISON
    do_compare                                  # SIMILARITY
    [[ $col1 -eq 2 ]] && { break ; }
  done < <(cat accuracy.tsv ) | tee /tmp/jrout
  pbcopy < /tmp/jrout
  echo -e "\n Results copied to clipboard.\n"
}


###################################
# Compare original sql with new sql
# col1 = Serial
# col2 = Question
# col3 = Query
do_compare_sqls() {
  while IFS=$'\t' read -r col1 col2 col3 ; do
    echo '--------------------------------------------------------------'
    echo Serial: $col1
    _QUESTION=$(echo "${col2}" | sed 's/"/\\"/g')
    _SQL_ORIG="${col3}"
    echo _QUESTION=$_QUESTION
    get_applicationId
    echo _APPLICATIONID=$_APPLICATIONID
    get_topicid
    echo _TOPICID=$_TOPICID
    post_message
    echo _MSG_BODY=$_MSG_BODY
    echo _MSG_BODY_ID=$_MSG_BODY_ID
    get_message_details
    echo _MSG_DETAILS=$_MSG_DETAILS
    echo =========== _SQL=$_SQL
    echo "${_SQL}" | md5sum
    echo =========== _SQL_ORIG=$_SQL_ORIG
    echo "${_SQL_ORIG}" | md5sum
    [[ $col1 -eq 1 ]] && { break ; }
  done < <(cat accuracy.tsv )
}

do_compare_sqls_test() {
  while IFS=$'\t' read -r col1 col2 col3 ; do
    echo '--------------------------------------------------------------'
    echo Serial: $col1
    _QUESTION=$(echo "${col2}" | sed 's/"/\\"/g')
    _SQL_ORIG="${col3}"
    #_QUESTION="$(cat myquestion)"
    echo _QUESTION=$_QUESTION
    get_applicationId
    echo _APPLICATIONID=$_APPLICATIONID
    get_topicid
    echo _TOPICID=$_TOPICID
    post_message
    echo _MSG_BODY=$_MSG_BODY
    echo _MSG_BODY_ID=$_MSG_BODY_ID
    get_message_details
    echo _MSG_DETAILS=$_MSG_DETAILS
    echo =========== _SQL=$_SQL
    echo "${_SQL}" | md5sum
    echo =========== _SQL_ORIG=$_SQL_ORIG
    echo "${_SQL_ORIG}" | md5sum
    [[ $col1 -eq 2 ]] && { break ; }
  done < <(cat accuracy.tsv )
}

