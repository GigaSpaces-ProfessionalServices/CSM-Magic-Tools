function usage() {

  cat << EOF

  NAME

    $(basename $0) – Test accurracy of goldenset

  USAGE:

    $(basename $0) [<options>]

  OPTIONS:

    -t                Test accuracy of goldenset file
    -file <filename>  Give name of accurracy file to use. Defaults to use file "accuracy.tsv" in current directory.
    -tok <value>      Set TOKEN
    -api <name>       Set API. Supported: tempo2, goldenset
    -f <id num>       Set FIRST ID to process. Default is whole accurracy file.
    -l <id num>       Set LAST ID to process. Default is whole accurracy file.
    -s <seconds>      Set sleep value between each line test. Defautl none.
    -getids           DISPLAY ALL TOPIC IDS (specify as last argument in cli)
    -deleteids        DELETE ALL TOPIC IDS (specify as last argument in cli)
    -h                Help - Display usage

  DEFAULT

    $(basename $0) -h

  EXAMPLES:

   $(basename $0) -file tempo2.tsv -t     # Specify file to test
   $(basename $0) -f 1 -l 1 -t            # Test only ID=1
   $(basename $0) -api tempo2             # Change API's "eRAG experimental app" and "FastAPI" to tempo2
   $(basename $0) -tok '...'              # Specify token
   $(basename $0) -f 1 -l 5 -api tempo2 -tok '...' -file tempo2.tsv -t    # Run queries found between 1-5
   $(basename $0) -api goldenset -tok '...' -file goldenset.tsv -t        # Run all queries

EOF
exit

}

