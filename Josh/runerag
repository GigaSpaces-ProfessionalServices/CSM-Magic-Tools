# GET 1 - Get application id - eRAG experimental app/Get All Applications
##  'https://tenant-goldenset.erag-c1.gigaspaces.net/api/erag-backend/v1/applications' \
function get_applicationid() {

  _HTTP_CODE["${FUNCNAME[0]}"]=$( curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'GET' \
  "${eRAG_experimental_app}/v1/applications" \
  -H 'accept: application/json' \
  -H "${_TOK}")
  _APPLICATIONID="$( jq -e '.[].applicationId' < ${_CURL_RESPONSE} 2> $_ERR_LOG_TMP )"
  [[ $? -ne 0 ]] && { printf "%s\n" "$(date '+%Y-%m-%d %H:%M:%S') $_SERIAL get_applicationid " ; cat $_ERR_LOG_TMP ; } >> $_ERR_LOG
  echo "${_APPLICATIONID}" > debug/${my_id}_APPLICATIONID-$_OUTPUT   #debug

}

