function do_compare() {
python3 << EOF
import sys
from difflib import SequenceMatcher

# Load the raw HTML from r1
with open('r1', 'r', encoding='utf-8') as f:
    html_1 = f.read()

# Load the raw HTML from r2
with open('r2', 'r', encoding='utf-8') as f:
    html_2 = f.read()

# Compare the two HTML strings with difflib
matcher = SequenceMatcher(None, html_1, html_2)
similarity_ratio = matcher.ratio()  # returns a value between 0 and 1

similarity_percentage = similarity_ratio * 100
#print(f"Similarity: {similarity_percentage:.2f}%")
print(f"{similarity_percentage:.2f}%")
EOF
}

function do_compare_json() {
python3 << EOF
import json
from difflib import SequenceMatcher
# Load and parse JSON from r1
with open('r1', 'r', encoding='utf-8') as f:
    data1 = json.load(f)
nl_result_1 = data1['nl_result']
# Load and parse JSON from r2
with open('r2', 'r', encoding='utf-8') as f:
    data2 = json.load(f)
nl_result_2 = data2['nl_result']
# Use difflib to compare the two strings
matcher = SequenceMatcher(None, nl_result_1, nl_result_2)
similarity_ratio = matcher.ratio()  # returns a value between 0 and 1

similarity_percentage = similarity_ratio * 100
print(f"Similarity: {similarity_percentage:.2f}%")
EOF
}

function usage() {

  cat << EOF

  USAGE:

    $(basename $0) [<options>]

  OPTIONS:

    -g1               Get applicationId
    -g2               Get 2
    -g3               Get 3
    -g4               Get 4
    -sql              Compare SQL's in loop
    -sql2             Compare SQL's in loop v2
    -t                Test
    -q1               Save query to r1
    -q2               Save query to r2
    -c                Compare r1 to r2
    -l [count]        Loop "count" times (save query to r2 and compare r1 with r2). Default is count=1
    -h                Help - Display usage

  DEFAULT

    -h

  ACTIONS:

  EXAMPLES:

   $(basename $0) -c

EOF
exit

}

function do_menu() {

[[ $# -eq 0 || $1 == "-h" ]] && usage

check_python_venv
while [[ $# -ne 0 ]] ; do

  case $1 in
    "-g1") 
        get_applicationId
        #echo _APPLICATIONID=$_APPLICATIONID
        ;;
    "-g2") 
        get_applicationId
        get_topicid
        #echo _TOPICID=$_TOPICID
        ;;
    "-g3") 
        echo "running get_applicationId" ; get_applicationId
        echo _APPLICATIONID=$_APPLICATIONID
        echo "running get_topicid" ; get_topicid
        echo _TOPICID=$_TOPICID
        echo "running post_message" ; post_message
        echo _MSG_BODY_ID=$_MSG_BODY_ID
        ;;
    "-g4") 
        #echo "running get_applicationId" ; get_applicationId
        get_applicationId
        #echo _APPLICATIONID=$_APPLICATIONID
        #echo "running get_topicid" ; get_topicid
        get_topicid
        ##echo _TOPICID=$_TOPICID $(LC_ALL=US date) >> topic-msg
        #echo "running post_message" ; post_message
        post_message
        ##echo _MSG_BODY_ID=$_MSG_BODY_ID $(LC_ALL=US date) >> topic-msg
        #echo "running get_message_details" ; get_message_details
        get_message_details
        echo $_SQL
        ;;
    "-sql") 
        do_compare_sqls
        ;;
    "-sql2") 
        do_compare_sqls2
        ;;
    "-t") 
        do_compare_sqls_test
        ;;
    "-q1") 
        do_query1
        ;;
    "-q2") 
        do_query2
        ;;
    "-h") 
        usage
        ;;
    *) echo -e "\nOption \"${1}\" unknown\n"
       ;;
  esac
  shift

done

}

########## MAIN ##########

do_menu "${@}"

