source "$VENV_PATH/bin/activate" || { echo "Failed to activate virtual environment"; exit 1; }
# Step 3: Check if beautifulsoup4 is installed
if ! pip show beautifulsoup4 > /dev/null 2>&1; then
    #echo "BeautifulSoup4 is not installed. Installing it now..."
    pip install beautifulsoup4 || { echo "Failed to install BeautifulSoup4"; exit 1; }
fi
}

# FUNCTIONS

# GET 1 - Get application id - eRAG experimental app/Get All Applications
function get_applicationid() {
  _HTTP_CODE["${FUNCNAME[0]}"]=$( curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'GET' \
  'https://tenant-goldenset.erag-c1.gigaspaces.net/api/erag-backend/v1/applications' \
  -H 'accept: application/json' \
  -H "${_TOK}")
  #_HTTP_CODE["${FUNCNAME[0]}"]="${_APPLICATIONID}"
  _APPLICATIONID="$(jq '.[].applicationId' < ${_CURL_RESPONSE})"
  #echo _APPLICATIONID=$_APPLICATIONID
}

# GET 2 - Get topic id - FastAPI/get all topics for this app for this user
function get_topicid() {
  _HTTP_CODE["${FUNCNAME[0]}"]=$(curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'GET' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${_TOK}")
  _TOPICID="$(jq '.[].id' < ${_CURL_RESPONSE})"
  #declare -p _HTTP_CODE
  #echo _TOPICID="${_TOPICID}"
}

# GET 3 - Get message body id - FastAPI/Submit a new question to the topic
function post_message() {
  _HTTP_CODE["${FUNCNAME[0]}"]=$(curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'POST' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics/${_TOPICID}/messages" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${_TOK}" \
  -H 'Content-Type: application/json' \
  -d '{ "message": "'"${_QUESTION}"'" }')
  _MSG_BODY="$(cat ${_CURL_RESPONSE})"
  _MSG_BODY_ID="$(echo "${_MSG_BODY}" | jq '.[] | select(.role == "assistant") | .id')"
  #echo _MSG_BODY="${_MSG_BODY}"
  #echo _MSG_BODY_ID="${_MSG_BODY_ID}"
  #declare -p _HTTP_CODE
}

# GET 4 - Use message_id to get sql "Current SQL statement - generated" - FastAPI/Get message details
function get_message_details() {
  _HTTP_CODE["${FUNCNAME[0]}"]=$(curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'GET' \
  "https://tenant-goldenset.erag-c1.gigaspaces.net/api/data-lab/v1/applications/${_APPLICATIONID}/data-lab/topics/${_TOPICID}/messages/${_MSG_BODY_ID}" \
  -H 'accept: application/json' \
  -H "user-id: ${_USERID}" \
  -H "${_TOK}")
  _MSG_DETAILS="$(cat ${_CURL_RESPONSE})"
  _SQL=$(echo "${_MSG_DETAILS}" | jq -r '.sql')
  _SQL_SED=$(echo "${_SQL}" | sed 's/"/\\"/g')
  declare -p _HTTP_CODE >> HTTP_CODE
  #echo _MSG_DETAILS="${_MSG_DETAILS}"
  #echo _SQL="${_SQL}"
  #echo _SQL_SED="${_SQL_SED}"
}

# Use sql/sql_orig to get "data" and "nl_result" - eRAG experimental app - Sql Nlp Query
# $1 - sql statement
get_nl_result() {
  local run_sql="$(echo -n "${1}" | tr -d '\n\r')"
  _HTTP_CODE["${FUNCNAME[0]}"]=$(curl -s -o $_CURL_RESPONSE -w "%{http_code}" -X 'POST' \
  'https://tenant-goldenset.erag-c1.gigaspaces.net/api/erag-backend/v1/toucan-sql/sql-nlp-query' \
  -H 'accept: application/json' \
  -H "${_TOK}" \
  -H 'Content-Type: application/json' \
  -d '{
  "query": "",
  "sql": "'"${run_sql}"'",
  "model": "azure-openai-gpt4o-2024-08-06",
  "applicationId": "'"${_APPLICATIONID}"'"
  }'
  )           # End of curl subprocess
  echo -e "\n$(LC_ALL=US date)" >> GET_NL_RESULT
  cat ${_CURL_RESPONSE} | tee -a GET_NL_RESULT
}

html_to_text() {
html="${1}"

# Convert HTML to a single line of text using BeautifulSoup, TR and SED
text=$(python3 <<EOF
import sys
from bs4 import BeautifulSoup

html_data = """$html"""
soup = BeautifulSoup(html_data, 'html.parser')

# Get all the text, separated by spaces instead of newlines
plain_text = soup.get_text(separator=' ')

# Strip leading/trailing spaces
plain_text = plain_text.strip()

print(plain_text)
EOF
)

echo -ne "$(echo "${text}" | tr '\n' ' ' | sed 's/  */ /g')"
}


###################################
# Compare original sql with new sql
# col1 = Serial
# col2 = Question
# col3 = Query
# Date, question ID, question, Confirmed query, Current query, comparison results (correct, not correct, inconclusive)
# put it in a CSV
do_compare_sqls() {
  while IFS=$'\t' read -r col1 col2 col3 ; do
    [[ $col1 -lt $_FIRST_ID ]] && { continue ; }
    _QUESTION=$(echo "${col2}" | sed 's/"/\\"/g')
    _SQL_ORIG="$(echo -n "${col3}" | tr -d '\r\n')"
    _SQL_ORIG_SED="$(echo ${col3} | sed 's/"/\\"/g')"

    get_applicationid                         # set _APPLICATIONID
    get_topicid                               # set _TOPICID
    echo "${_QUESTION}" > QUESTION
    post_message                              # set _MSG_BODY and _MSG_BODY_ID

    #echo -e "\n $col1 \n"
    #echo -e "\n _MSG_BODY=$_MSG_BODY\n"
    #echo -e "\n _MSG_BODY_ID=$_MSG_BODY_ID\n"
    get_message_details                       # set _MSG_DETAILS, _SQL and _SQL_SED 
    #echo -e "\n${_MSG_DETAILS}\n"
    #echo -e "\n_SQL_SED=${_SQL_SED}\n"
    #echo -e "\n_SQL_ORIG_SED=${_SQL_ORIG_SED}\n"

    # Get Natural Language answer according to SQL statement
    # _SQL_ORIG_SED
    echo "${_SQL_ORIG_SED}" > SQL_ORIG_SED
    _NL_RESULT_ORIG="$(get_nl_result "${_SQL_ORIG_SED}")"
    echo "${_NL_RESULT_ORIG}" > NL_RESULT_ORIG
    _DATA_ORIG="$(echo ${_NL_RESULT_ORIG} | jq '.tabular_data.data' | tr -d '\n' | tee DATA_ORIG)"
    declare -p _HTTP_CODE >> HTTP_CODE
    # _SQL_SED
    echo "${_SQL_SED}" > SQL_SED
    _NL_RESULT="$(get_nl_result "${_SQL_SED}")"
    echo "${_NL_RESULT}" > NL_RESULT
    _DATA="$(echo ${_NL_RESULT} | jq '.tabular_data.data' | tr -d '\n' | tee DATA)"
    declare -p _HTTP_CODE >> HTTP_CODE

    #============================================ COMPARISON
    r1_empty="$(echo -n "${_DATA_ORIG}" | tr -d '[] \n')"
    r2_empty="$(echo -n "${_DATA}" | tr -d '[] \n')"


    # Print report
    echo -ne "$(date '+%Y/%m/%d')\t"            # DATE
    echo -ne "${col1}\t"                        # QUESTION ID
    echo -ne "${col2}\t"                        # QUESTION

    echo -ne "${_SQL_ORIG}\t"
    if [[ $(echo ${_DATA_ORIG} | wc -c) -gt 49999 ]] ; then
      echo -ne "FIELD TOO LARGE\t"
    else
      echo -ne ${_DATA_ORIG}"\t"
    fi
    #echo -ne "${_ERAG_ORIG_ANSWER}\t"

    echo -ne "${_SQL}\t"
    if [[ $(echo ${_DATA} | wc -c) -gt 49999 ]] ; then
      echo -ne "FIELD TOO LARGE\t"
    else
      echo -ne ${_DATA}"\t"
    fi
    #echo -ne "${_ERAG_ANSWER}\t"

    if [[ -z $r1_empty && -z $r2_empty ]] ; then 
      echo -ne "same\t"
    else
      [[ "$(echo -n "${_DATA_ORIG}" | md5sum)" == "$(echo -n "${_DATA}" | md5sum)" ]] && echo -ne "same\t" || echo -ne "different\t"   
    fi
    do_compare                                  # SIMILARITY in percentage 0-100%

    [[ $col1 -ge $_LAST_ID ]] && { break ; }
  done < <(cat accuracy.tsv ) | tee /tmp/jrout
  pbcopy < /tmp/jrout
  echo -e "\n Results copied to clipboard.\n"
}

function do_compare() {
python3 << EOF
import sys
from difflib import SequenceMatcher

# Load the raw HTML from r1
with open('DATA_ORIG', 'r', encoding='utf-8') as f:
    html_1 = f.read()

# Load the raw HTML from r2
with open('DATA', 'r', encoding='utf-8') as f:
    html_2 = f.read()

# Compare the two HTML strings with difflib
matcher = SequenceMatcher(None, html_1, html_2)
similarity_ratio = matcher.ratio()  # returns a value between 0 and 1

similarity_percentage = similarity_ratio * 100
#print(f"Similarity: {similarity_percentage:.2f}%")
print(f"{similarity_percentage:.2f}%")
EOF
}

function usage() {

  cat << EOF

  USAGE:

    $(basename $0) [<options>]

  OPTIONS:

    -g1               Get Application ID  - Run: get_applicationid
    -g2               Get Topic ID        - Run: get_applicationid get_topicid
    -g3               Get Message ID      - Run: get_applicationid get_topicid post_message
    -g4               Get SQL             - Run: get_applicationid get_topicid post_message get_message_details
    -sql              Compare SQL's in loop
    -f                Set first ID to process
    -l                Set last ID to process
    -h                Help - Display usage

  DEFAULT

    -h

  ACTIONS:

  EXAMPLES:

   $(basename $0) -c

EOF
exit

}

function do_menu() {

[[ $# -eq 0 || $1 == "-h" ]] && usage

check_python_venv
while [[ $# -ne 0 ]] ; do

  case $1 in
    "-g1") 
        get_applicationid
        #echo _HTTP_CODE="${_HTTP_CODE["get_applicationid"]}"
        #echo _APPLICATIONID="${_APPLICATIONID}"
        ;;
    "-g2") 
        get_applicationid
        get_topicid
        #echo _TOPICID=$_TOPICID
        ;;
    "-g3") 
        echo "running get_applicationid" ; get_applicationid
        echo _APPLICATIONID=$_APPLICATIONID
        echo "running get_topicid" ; get_topicid
        echo _TOPICID=$_TOPICID
        echo "running post_message" ; post_message
        echo _MSG_BODY_ID=$_MSG_BODY_ID
        ;;
    "-g4") 
        echo -e "\n----------running get_applicationid\n" ; get_applicationid
        echo -e _APPLICATIONID=$_APPLICATIONID
        echo -e "\n----------running get_topicid\n" ; get_topicid
        echo -e _TOPICID=$_TOPICID               # $(LC_ALL=US date) >> topic-msg
        echo -e "\n----------running post_message\n" ; post_message
        echo -e _MSG_BODY_ID=$_MSG_BODY_ID       # $(LC_ALL=US date) >> topic-msg
        echo -e "\n----------running get_message_details\n" ; get_message_details
        echo -e "\n_MSG_DETAILS=${_MSG_DETAILS}\n"
        echo -e "\n_SQL=${_SQL}\n"
        ;;
    "-sql") 
        do_compare_sqls
        ;;
    "-f") 
        shift ; _FIRST_ID=$1
        ;;
    "-l") 
        shift ; _LAST_ID=$1
        ;;
    "-h") 
        usage
        ;;
    *) echo -e "\nOption \"${1}\" unknown\n"
       ;;
  esac
  shift

done

}

########## MAIN ##########

do_menu "${@}"

